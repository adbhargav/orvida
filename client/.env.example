# Base URL of the ORVIDA API, including the /api suffix.
# Local development:
VITE_API_BASE_URL=http://localhost:5001/api

# Production (set in .env.production, used automatically by `vite build`):
# VITE_API_BASE_URL=https://api.orivida.in/api

# Public site origin — canonical URLs, Open Graph and structured data
VITE_SITE_URL=https://orivida.in
