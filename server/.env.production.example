# ORIVIDA API — production template for the VPS.
#
#   cp .env.production.example .env    (on the server, then fill it in)
#   chmod 600 .env                     (it holds every secret the app has)
#
# Never commit the filled-in file. Values marked REQUIRED will stop the
# server or disable a feature outright if left blank.

# ---------------------------------------------------------------- runtime --
NODE_ENV=production
# nginx proxies to this port on 127.0.0.1; it is never exposed publicly.
PORT=5001

# ------------------------------------------------------------------- urls --
# Browser origins allowed to call this API. The storefront's origin MUST be
# listed or every request from it is refused. Comma-separated.
CLIENT_URL=https://orvida.in
ADDITIONAL_ORIGINS=https://www.orvida.in,https://orvida.vercel.app

# Where this API answers. Used to build URLs for uploaded images, so it must
# be the public https origin, not localhost and not the bare IP.
PUBLIC_ASSET_URL=https://api.orvida.in

# The storefront's origin — canonical URLs, sitemap and robots.txt.
SITE_URL=https://orvida.in

# ---------------------------------------------------------------- database --
# REQUIRED. Managed Postgres (Neon) or a local one on the VPS. A local
# instance needs no sslmode; a managed one usually requires it.
DATABASE_URL=postgresql://user:password@host:5432/orvida?sslmode=require

# ------------------------------------------------------------------- auth --
# REQUIRED. The server refuses to start in production without this.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Firebase Admin (Google Sign-In + password-reset emails). Pick ONE form.
# A file is the cleanest on a VPS, since there is a real filesystem:
FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/orvida/secrets/firebase-service-account.json
# Or base64 of that same JSON, if you would rather keep it in this file:
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------------------------------------------------------------- payments --
# Live keys. Without both, checkout returns 503 rather than accepting a
# payment it cannot verify.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create the webhook at https://api.orvida.in/api/payments/webhook/razorpay
# subscribed to payment.captured, payment.failed, order.paid,
# refund.processed, refund.failed — then paste the same secret here.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- shipping --
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=https://track.delhivery.com
# Must match the warehouse name registered in the Delhivery dashboard exactly,
# including case — a mismatch fails with "ClientWarehouse matching query does
# not exist".
DELHIVERY_PICKUP_NAME=orvida
DELHIVERY_PICKUP_PINCODE=500029
# Leave DELHIVERY_MOCK unset in production. Setting it fabricates AWBs.

# ------------------------------------------------------------------- email --
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ORIVIDA <no-reply@orvida.in>"
# Internal alerts (new customer, new gifting enquiry) go here.
ADMIN_EMAIL=

# ----------------------------------------------------------------- company --
# Printed on invoices and shipping labels. The registered address lives in
# src/config/company.js.
COMPANY_PHONE=+91 70957 56434
COMPANY_EMAIL=support@orvida.in
COMPANY_WEBSITE=orvida.in
# Left blank, the invoice omits the line rather than printing a placeholder.
COMPANY_GSTIN=
COMPANY_PAN=
