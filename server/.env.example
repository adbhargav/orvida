# Server
PORT=5001
NODE_ENV=development

# Comma-separated list of browser origins allowed to call this API.
# In production this MUST list your real storefront origin(s) — the API
# rejects any origin not named here.
CLIENT_URL=http://localhost:5173
# ADDITIONAL_ORIGINS=https://www.orvida.com,https://orvida.vercel.app

# Public base URL used when building URLs for uploaded files (banners,
# product images, the logo on invoices). Must be reachable by the browser.
PUBLIC_ASSET_URL=http://localhost:5001

# Company details printed on invoices, shipping labels and email.
# The registered address lives in src/config/company.js; these override the
# contact and tax fields without a code change.
COMPANY_PHONE=+91 70957 56434
COMPANY_EMAIL=support@orvida.com
COMPANY_WEBSITE=orvida.com
# Leave GSTIN blank until you have one — the invoice omits the line entirely
# rather than printing a placeholder.
COMPANY_GSTIN=
COMPANY_PAN=

# Where internal alerts (new customer, new gifting enquiry) are delivered.
ADMIN_EMAIL=

# PostgreSQL — a single connection string is preferred.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Or discrete credentials:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=orvida

# Authentication — generate a long random value for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Firebase Admin SDK (Google Sign-In).
# Provide EITHER a path to the service-account JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/service-account.json
# OR the raw JSON as a single-line string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# OR the discrete fields:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Razorpay. Without both values the checkout endpoints return 503 rather
# than accepting an unverifiable payment.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Webhook signing secret. Create the webhook in the Razorpay dashboard at
#   https://<your-api-host>/api/payments/webhook/razorpay
# subscribed to: payment.captured, payment.failed, order.paid,
#                refund.processed, refund.failed
# then paste the same secret here. Deliveries are rejected without it.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Transactional email (Nodemailer over SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ORVIDA <no-reply@orvida.com>"

# Delhivery courier integration (backend only — never exposed to frontend)
DELHIVERY_API_TOKEN=your_delhivery_api_token
# Staging: https://staging-express.delhivery.com
DELHIVERY_BASE_URL=https://track.delhivery.com
# The registered warehouse/pickup-location name in your Delhivery account
DELHIVERY_PICKUP_NAME=ORVIDA
DELHIVERY_PICKUP_PINCODE=500029
# Optional: 'true' enables deterministic mock responses for local development
# DELHIVERY_MOCK=true
# Optional: fallback parcel weight for products without shipping details
# DELHIVERY_DEFAULT_WEIGHT_KG=1
