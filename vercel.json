{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://api.orivida.in/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://api.orivida.in/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

